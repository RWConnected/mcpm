{
  "name": "mcpm",
  "private": true,
  "version": "1.0.7",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --watch packages/cli/src/index.ts --",
    "build": "bun build --compile --minify packages/cli/src/index.ts --outfile dist/mcpm",
    "test": "bun test",
    "test:core": "bun test packages/core",
    "test:cli": "bun test packages/cli",
    "typecheck": "bunx tsc --build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
